{
  "manifest_version": 3,
  "name": "FIRE prompts — Free AI Prompt Optimizer for ChatGPT & Claude",
  "description": "Transform unclear questions into expert prompts. Get better AI responses from ChatGPT and Claude with one click. Powered by Gemini & Groq.",
  "version": "2.2",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "prompt-engine.js",
        "gemini-api.js",
        "groq-api.js",
        "content.js"
      ],
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ]
}